SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key
CV_DOWNLOAD_SECRET=replace-with-at-least-32-random-characters
# Production: base64-encoded PDF kept as a sensitive Vercel variable.
# Development falls back to private/cv-diego-obando.pdf when this is unset.
CV_PDF_BASE64=base64-encoded-cv-pdf

# Signs the Ataxx arena identity cookie. Falls back to CV_DOWNLOAD_SECRET when unset.
ARENA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Development only: `next dev` does not run api/engine.py, so point this at a
# local `scripts/serve-arena-local.py` to play against the real models.
# ARENA_ENGINE_URL=http://127.0.0.1:3011
