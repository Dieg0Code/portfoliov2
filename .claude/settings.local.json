{
  "permissions": {
    "allow": [
      "Skill(playwright-cli)",
      "Skill(playwright-cli:*)",
      "Bash(npm run:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(ls *.png)",
      "Bash(ls .playwright-cli/*.png)",
      "Bash(playwright-cli resize:*)",
      "Bash(playwright-cli run-code:*)",
      "Bash(playwright-cli eval:*)",
      "Bash(playwright-cli reload:*)",
      "Bash(playwright-cli close:*)",
      "Bash(taskkill //F //IM node.exe //FI \"WINDOWTITLE eq *\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000 --max-time 3)",
      "Bash(netstat -ano)",
      "Bash(taskkill //F //PID 2968)"
    ]
  }
}
